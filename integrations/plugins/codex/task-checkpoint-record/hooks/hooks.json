{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 2,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 2,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 2,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 2,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 1,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 1,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 2,
            "async": false,
            "command": "/usr/bin/env -u BUN_OPTIONS -u NODE_OPTIONS bun --no-env-file --no-install --config=\"$PLUGIN_ROOT/runtime/recorder/config/runtime.bunfig.toml\" \"$PLUGIN_ROOT/scripts/hook.ts\""
          }
        ]
      }
    ]
  }
}
