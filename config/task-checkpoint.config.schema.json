{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lwyBZss8924d/task-checkpoint-record/config/task-checkpoint.config.schema.json",
  "title": "Unified task checkpoint configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "task-checkpoint.config.v1"
    },
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state_dir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Literal absolute or config-directory-relative path; no tilde, dollar expansion or parent components."
        },
        "helper_command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "lease_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 120000
        },
        "page_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "page_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 8388608
        }
      }
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Literal absolute or config-directory-relative path; no tilde, dollar expansion or parent components."
            },
            {
              "type": "null"
            }
          ]
        },
        "home": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "description": "Literal absolute or config-directory-relative path; no tilde, dollar expansion or parent components."
            },
            {
              "type": "null"
            }
          ]
        },
        "supervisor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "enum": [
                "gpt-6-sol",
                "gpt-6-luna"
              ]
            },
            "effort": {
              "enum": [
                "medium",
                "high"
              ]
            }
          }
        },
        "semantic_worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "enum": [
                "gpt-6-sol",
                "gpt-6-luna"
              ]
            },
            "effort": {
              "enum": [
                "medium",
                "high"
              ]
            }
          }
        },
        "eval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "enum": [
                "gpt-6-sol",
                "gpt-6-luna"
              ]
            },
            "effort": {
              "enum": [
                "medium",
                "high"
              ]
            }
          }
        }
      }
    },
    "agent_service": {
      "type": "object",
      "additionalProperties": false,
      "description": "Policy ceilings for explicit native agent activation only; configuration never starts services or models.",
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_native_turns": {
          "type": "integer",
          "minimum": 2,
          "maximum": 33,
          "description": "Admitted native turn/start operations per round, including one supervisor turn and at most max_workers worker turns. Native internal HTTP retries and tool-followup model requests are not separately observable or hard-limited by this counter."
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "data_policy": {
          "enum": [
            "metadata_only",
            "prepared_fragments"
          ]
        },
        "external_score_max_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "openrouter",
            "typesafe"
          ]
        },
        "model": {
          "enum": [
            "typesafe/jev-1.13-20260917",
            "jev-1.13.0"
          ]
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
          "not": {
            "anyOf": [
              {
                "enum": [
                  "HOME",
                  "PATH",
                  "USER",
                  "LOGNAME",
                  "TMPDIR",
                  "TEMP",
                  "TMP",
                  "LANG",
                  "LC_ALL",
                  "TZ",
                  "SYSTEMROOT",
                  "WINDIR",
                  "CODEX_HOME",
                  "SHELL",
                  "ENV",
                  "BASH_ENV",
                  "ZDOTDIR",
                  "SHELLOPTS",
                  "BASHOPTS",
                  "IFS",
                  "CDPATH",
                  "RUBYOPT",
                  "PERL5OPT",
                  "OPENSSL_CONF",
                  "SSL_CERT_FILE",
                  "SSL_CERT_DIR"
                ]
              },
              {
                "pattern": "^(?:BUN_|NODE_|LD_|DYLD_|PYTHON|TASK_CHECKPOINT_RECORD_|CLAUDE_|PI_)"
              },
              {
                "pattern": "(?:^|_)PROXY$"
              }
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deadline_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20000
            },
            "max_request_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "max_response_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "typesafe"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "model": {
                "const": "jev-1.13.0"
              }
            }
          },
          "else": {
            "properties": {
              "model": {
                "const": "typesafe/jev-1.13-20260917"
              }
            }
          }
        }
      ]
    }
  },
  "description": "Runtime also enforces literal-path rules, lease_ms > timeout_ms + 500, agent concurrency <= max_workers and max_workers + 1 <= max_native_turns. Unknown keys are errors; no endpoints or inline credentials."
}
